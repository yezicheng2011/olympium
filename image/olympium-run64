#
# Runs one 64-bit x86 program on a 32-bit system. A 64-bit kernel is booted
# under qemu-system-x86_64, which on this image is itself a 32-bit program.
# The guest has a 64-bit address space. Its RAM is a file on an extra disk
# when one is available, and the 32-bit kernel can page the translator to swap.
# This script is not the path for a 32-bit program on a 64-bit CPU.
set -u
HOLD=0
if [ "${1:-}" = "--hold" ]; then
	HOLD=1
	shift
fi
if [ "${1:-}" = "--no-hold" ]; then
	shift
fi
PROG=${1:-}
if [ -z "$PROG" ] || [ ! -f "$PROG" ]; then
	echo "olympium-run64: need a 64-bit program" >&2
	exit 2
fi
base=$(basename "$PROG")
case "$base" in
	hello64) CMD=hello ;;
	highmap64) CMD=highmap ;;
	bash) CMD=bash ;;
	*) CMD=payload ;;
esac
GUEST=/usr/lib/olympium/amd64
if [ ! -f "$GUEST/vmlinuz" ] || [ ! -f "$GUEST/initrd.cpio" ]; then
	echo "olympium-run64: the 64-bit guest files are not installed" >&2
	exit 1
fi
if [ ! -x /usr/bin/qemu-system-x86_64 ]; then
	echo "olympium-run64: qemu-system-x86_64 is not installed" >&2
	exit 1
fi

kmsg() {
	printf '%s\n' "$*"
	printf '<6>olympium-run64: %s\n' "$*" >/dev/kmsg 2>/dev/null || true
}

DISK_MNT=""
setup_backing() {
	want_format=0
	if grep -q 'olympium.formatdisk=1' /proc/cmdline 2>/dev/null; then
		want_format=1
	fi
	if [ "${OLYMPIUM64_FORMAT:-0}" = 1 ]; then
		want_format=1
	fi
	root=$(findmnt -n -o SOURCE / 2>/dev/null || true)
	for dev in ${OLYMPIUM64_DISK:-} /dev/vdb /dev/vda /dev/sdb /dev/sda; do
		[ -b "$dev" ] || continue
		case "$root" in
			"$dev"|"$dev"p*|"$dev"[0-9]*) continue ;;
		esac
		mp=$(findmnt -n -o TARGET "$dev" 2>/dev/null || true)
		if [ -n "$mp" ]; then
			# A later program in the same session finds the disk already mounted.
			if [ "$mp" = /var/lib/olympium/disk ]; then
				DISK_MNT=$mp
				break
			fi
			continue
		fi
		fstype=$(blkid -o value -s TYPE "$dev" 2>/dev/null || true)
		case "$fstype" in
			swap)
				swapon "$dev" 2>/dev/null && kmsg "swap on $dev"
				;;
			ext2|ext3|ext4)
				mkdir -p /var/lib/olympium/disk
				if mount "$dev" /var/lib/olympium/disk; then
					DISK_MNT=/var/lib/olympium/disk
				fi
				;;
			"")
				if [ "$want_format" = 1 ]; then
					mkfs.ext4 -F -L OLYMPIUM64 "$dev" >/tmp/olympium64-mkfs.log 2>&1 || continue
					mkdir -p /var/lib/olympium/disk
					if mount "$dev" /var/lib/olympium/disk; then
						DISK_MNT=/var/lib/olympium/disk
						if [ ! -f "$DISK_MNT/swap" ]; then
							dd if=/dev/zero of="$DISK_MNT/swap" bs=1M count=2048 status=none
							mkswap "$DISK_MNT/swap" >/dev/null
						fi
						swapon "$DISK_MNT/swap" && kmsg "swap file on $dev"
						kmsg "formatted $dev for the 64-bit guest"
					fi
				fi
				;;
		esac
		if [ -n "$DISK_MNT" ]; then
			break
		fi
	done
	if [ -n "$DISK_MNT" ]; then
		if [ -f "$DISK_MNT/swap" ]; then
			swapon "$DISK_MNT/swap" 2>/dev/null || true
			kmsg "swap file $DISK_MNT/swap"
		fi
		kmsg "guest RAM file on $DISK_MNT"
	else
		kmsg "no extra disk; guest RAM is anonymous"
	fi
	awk '/MemAvailable|SwapTotal|SwapFree/ { print }' /proc/meminfo | while read -r line; do
		kmsg "$line"
	done
}

kmsg "begin $(uname -m) cmd=$CMD program=$PROG"
setup_backing
work=$(mktemp -d /tmp/olympium64.XXXXXX)
stage=$(mktemp -d /tmp/olympium64-stage.XXXXXX)
mkdir -p "$stage/payload"
printf '%s\n' "$CMD" > "$stage/payload/cmd"
if [ "$CMD" = payload ]; then
	cp "$PROG" "$stage/payload/program"
	chmod 755 "$stage/payload/program"
fi
(cd "$stage" && find . | cpio -o -H newc) > "$work/extra.cpio" 2>/dev/null
cat "$GUEST/initrd.cpio" "$work/extra.cpio" > "$work/initrd"
MEM=${OLYMPIUM64_MEM:-512}
set --
if [ -n "$DISK_MNT" ]; then
	truncate -s "${MEM}M" "$DISK_MNT/guest.ram"
	set -- -machine "pc,accel=tcg,memory-backend=mem" \
		-object "memory-backend-file,id=mem,size=${MEM}M,mem-path=$DISK_MNT/guest.ram,share=off,prealloc=off"
else
	set -- -machine pc,accel=tcg -m "$MEM"
fi
start=$(date +%s)
timeout "${OLYMPIUM64_TIMEOUT:-240}" qemu-system-x86_64 \
	"$@" \
	-kernel "$GUEST/vmlinuz" \
	-initrd "$work/initrd" \
	-append "console=ttyS0,115200 panic=1" \
	-serial file:"$work/serial" \
	-display none -no-reboot -monitor none \
	>"$work/qemu.err" 2>&1
qcode=$?
end=$(date +%s)
kmsg "qemu exit $qcode seconds $((end - start)) mem ${MEM}M"
if [ -f "$work/serial" ]; then
	sed -n '/OLYMPIUM64_BEGIN/,/OLYMPIUM64_END/p' "$work/serial" | while read -r line; do
		kmsg "$line"
	done
else
	kmsg "no guest serial"
	tail -n 20 "$work/qemu.err" 2>/dev/null | while read -r line; do
		kmsg "qemu: $line"
	done
fi
awk '/SwapTotal|SwapFree/ { print }' /proc/meminfo | while read -r line; do
	kmsg "after $line"
done
rm -rf "$stage"
if [ "$HOLD" = 1 ]; then
	kmsg "holding the terminal"
	sleep "${OLYMPIUM64_HOLD:-150}"
fi
if [ "$qcode" -ne 0 ]; then
	exit "$qcode"
fi
exit 0
