diff --git a/src/frameworks/WebKit/CMakeLists.txt b/src/frameworks/WebKit/CMakeLists.txt
index e88b1fc7..2a009028 100644
--- a/src/frameworks/WebKit/CMakeLists.txt
+++ b/src/frameworks/WebKit/CMakeLists.txt
@@ -188,3 +188,12 @@ set_source_files_properties(
     src/WKWebsiteDataStore.m
     PROPERTIES COMPILE_FLAGS "-fobjc-arc"
 )
+
+# Older Intel binaries can bind Objective-C runtime symbols through WebKit.
+# Re-export the actual runtime objects and entry points to preserve identity.
+if (BUILD_TARGET_64BIT AND APPLE_ARCH_64BIT STREQUAL "x86_64")
+    set(web_kit_reexports "${CMAKE_CURRENT_SOURCE_DIR}/reexport.exp")
+    set_property(TARGET WebKit APPEND_STRING PROPERTY
+        LINK_FLAGS " -Xarch_x86_64 -Wl,-reexported_symbols_list,${web_kit_reexports}")
+    set_property(TARGET WebKit APPEND PROPERTY LINK_DEPENDS "${web_kit_reexports}")
+endif()
