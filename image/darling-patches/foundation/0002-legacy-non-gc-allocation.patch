+// Darling uses reference counting and has no Objective-C collector.
+void *NSAllocateCollectable(NSUInteger size, NSUInteger options)
+{
+    (void)options;
+    return calloc(1, size);
+}
+
+void *NSReallocateCollectable(void *ptr, NSUInteger size, NSUInteger options)
+{
+    return ptr == NULL ? NSAllocateCollectable(size, options) : realloc(ptr, size);
+}
