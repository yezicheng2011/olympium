# Session lines go to the kernel log and to any serial port the kernel already
# uses as a console, so a boot test can follow the desktop without a display.
# A serial port that is not a console is left alone: opening one can wait
# forever for a carrier.
serial_consoles=""
for name in $(cat /sys/class/tty/console/active 2>/dev/null); do
	case "$name" in
		ttyS*|ttyAMA*) serial_consoles="$serial_consoles /dev/$name" ;;
	esac
done
kmsg() {
	printf '<6>dev-desktop: %s\n' "$*" > /dev/kmsg 2>/dev/null || true
	for port in $serial_consoles; do
		(printf 'dev-desktop: %s\r\n' "$*" > "$port") 2>/dev/null || true
	done
}
mkdir -p /run/dev-desktop
chmod 755 /run/dev-desktop
kmsg "session start arch $(uname -m) $(uname -r)"
modprobe bochs 2>/dev/null || true
modprobe virtio_gpu 2>/dev/null || true
# Network/storage helpers and the inventory are not prerequisites for the
# first desktop frame. Keep graphics probing above synchronous.
(
	modprobe e1000 2>/dev/null || true
	modprobe virtio_net 2>/dev/null || true
	modprobe virtio_blk 2>/dev/null || true
	modprobe nvme 2>/dev/null || true
	# Links are only raised here when there is no NetworkManager. With it, a
	# link brought up before NetworkManager has looked at it already has an
	# address from router advertisements, and NetworkManager takes that over
	# as it is instead of running DHCP: the wired port then never gets an IPv4
	# address.
	if command -v ip >/dev/null 2>&1 && ! command -v NetworkManager >/dev/null 2>&1; then
		for iface in /sys/class/net/*; do
			name=$(basename "$iface")
			[ "$name" = lo ] && continue
			ip link set "$name" up 2>/dev/null || true
		done
	fi
	/usr/bin/driver-report >/tmp/driver-report.txt 2>&1 || true
) &
if grep -q 'olympium.contrast=1' /proc/cmdline 2>/dev/null; then
	export DEV_DESK_CONTRAST=1
fi
if grep -q 'olympium.gles=1' /proc/cmdline 2>/dev/null; then
	export WLR_RENDERER=gles2
	export LIBGL_ALWAYS_SOFTWARE=1
	export GALLIUM_DRIVER=llvmpipe
else
	export WLR_RENDERER="${WLR_RENDERER:-pixman}"
fi
export BROWSER=/usr/bin/firefox
export MOZ_ENABLE_WAYLAND=1
export OLYMPIUM_DESK_HOME=/var/lib/olympium/desk
mkdir -p "$OLYMPIUM_DESK_HOME" /run/dev-desktop
kmsg "renderer ${WLR_RENDERER}"
: > /run/dev-desktop/compositor.log
tail -n0 -f /run/dev-desktop/compositor.log | while IFS= read -r line; do
	kmsg "$line"
done &
echo $! > /run/dev-desktop/logpipe.pid
set +e
/usr/bin/dev-compositor -n -s /usr/libexec/dev-desktop/startup.sh >> /run/dev-desktop/compositor.log 2>&1
code=$?
set -e
kmsg "compositor exit ${code}"
if [ "$code" -ne 0 ] && [ "${WLR_RENDERER}" != pixman ]; then
	export WLR_RENDERER=pixman
	export DEV_DESK_CONTRAST=1
	kmsg "retry pixman contrast"
	exec /usr/bin/dev-compositor -n -s /usr/libexec/dev-desktop/startup.sh
fi
exit "$code"
