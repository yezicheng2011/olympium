#!/bin/bash
# Print the driver and firmware files this live image actually contains.
# It does not claim a device works just because the file is present.
set -u
KVER="$(uname -r)"
MOD="/lib/modules/${KVER}"
say() { printf '%s\n' "$*"; echo "olympium-drivers: $*" > /dev/kmsg 2>/dev/null || true; }
say "kernel ${KVER} arch $(uname -m)"
if [ ! -d "$MOD" ]; then
	say "no module tree at ${MOD}"
	exit 0
fi
want="e1000 virtio_net virtio_blk virtio_pci nvme ahci xhci-hcd xhci-pci usb-storage hid-multitouch i915 xe amdgpu radeon nouveau qxl snd snd-hda-intel btusb iwlwifi ath9k bochs virtio-gpu"
# Index once: probing each driver with find rescans the whole module tree.
# Preserve compressed module names and built-in drivers in the report.
declare -A module_files=() module_builtin=()
while IFS= read -r path; do
	base=${path##*/}
	name=${base%%.ko*}
	module_files["${name//-/_}"]=1
done < <(find "$MOD" -name '*.ko*' 2>/dev/null)
if [ -r "$MOD/modules.builtin" ]; then
	while IFS= read -r path; do
		base=${path##*/}
		name=${base%.ko}
		module_builtin["${name//-/_}"]=1
	done < "$MOD/modules.builtin"
fi
for name in $want; do
	alt="${name//-/_}"
	if [ "${module_files[$alt]+present}" ]; then
		say "module ${name} present"
	elif [ "${module_builtin[$alt]+present}" ]; then
		say "module ${name} built-in"
	else
		say "module ${name} absent"
	fi
done
for dir in i915 amdgpu radeon iwlwifi ath10k rtl_nic rtlwifi qca brcm mediatek cirrus; do
	if [ -d "/lib/firmware/${dir}" ]; then
		n="$(find "/lib/firmware/${dir}" -type f | wc -l)"
		say "firmware ${dir} files=${n}"
	else
		n="$(find /lib/firmware -maxdepth 2 -name "${dir}*" -type f 2>/dev/null | wc -l)"
		if [ "$n" -gt 0 ]; then
			say "firmware ${dir} files=${n}"
		else
			say "firmware ${dir} absent"
		fi
	fi
done
if [ -d /usr/lib/x86_64-linux-gnu/dri ] || [ -d /usr/lib/aarch64-linux-gnu/dri ]; then
	say "mesa dri present"
else
	say "mesa dri absent"
fi
say "proprietary nvidia and broadcom-sta are not bundled"
