#
# Starts one Mac program through Darling, when Darling is installed.
#
#   olympium-mac-run --check                 exit 0 when a Mac runtime is here
#   olympium-mac-run APP PROGRAM [ARG...]    start PROGRAM, the program of APP
#
# Darling is the open-source project that runs macOS programs on Linux, the
# way Wine runs Windows programs. It is not part of this tree and is not in
# Ubuntu's or Debian's archives. This script only calls it. dev-install has
# already checked the program's checksum and that it has code for this CPU.
#
# This script has not been run against a real Darling: the build machine for
# this tree could not download or build one. What it does is what Darling's
# own documentation says: "darling shell COMMAND" runs a command inside the
# Darling prefix, and the Linux file system is visible there under
# /Volumes/SystemRoot. If your Darling wants something else, this file is the
# one place to change.
#
# It does not check a code signature, and it does not get around one. Apple's
# own applications are licensed for Apple hardware and are not what this is
# for.
set -u
if [ "${1:-}" = "--check" ]; then
	command -v darling >/dev/null 2>&1
	exit $?
fi
if [ "$#" -lt 2 ]; then
	echo "usage: olympium-mac-run APP PROGRAM [ARG...]" >&2
	exit 2
fi
if ! command -v darling >/dev/null 2>&1; then
	echo "olympium-mac-run: Darling is not installed" >&2
	exit 3
fi
program=$2
shift 2
case "$program" in
	/*) ;;
	*) echo "olympium-mac-run: the program path must be absolute" >&2; exit 2 ;;
esac
exec darling shell "/Volumes/SystemRoot$program" "$@"
