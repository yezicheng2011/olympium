[Unit]
Description=Olympium desktop
# Not after systemd-user-sessions.service. That one waits for network.target,
# which waits for NetworkManager, and the desktop does not need the network.
# The session runs as root, so it does not need logins to be allowed either.
After=systemd-udev-trigger.service
[Service]
Type=simple
ExecStart=/usr/libexec/dev-desktop/run-session
Restart=on-failure
RestartSec=2
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Environment=XDG_RUNTIME_DIR=/run/dev-desktop
Environment=GDK_BACKEND=wayland

[Install]
WantedBy=multi-user.target
