#
# Starts the Olympium runtime when this image carries it. The runtime is a
# separate program built from its own repository; this script only runs it.
# Without it, the dock entry opens the explanation in Settings.
# The shell has no GPU path for clients, so GTK draws with its software renderer.
export GDK_BACKEND="${GDK_BACKEND:-wayland}"
export GSK_RENDERER="${GSK_RENDERER:-cairo}"
for bin in /usr/bin/olympium-linux /usr/bin/linkspan-linux /usr/local/bin/olympium-linux; do
	if [ -x "$bin" ]; then
		exec "$bin" "$@"
	fi
done
exec /usr/bin/dev-settings --page=olympium
