# Starts the real Firefox program. The desktop session runs as root, and
# Firefox refuses that, so the window runs as the olympium user. This script
# does not start a snap.
REAL=/usr/lib/firefox/firefox
if [ ! -x "$REAL" ]; then
	echo "firefox: /usr/lib/firefox/firefox is not installed" >&2
	exit 1
fi
if ! id olympium >/dev/null 2>&1; then
	echo "firefox: the olympium user is missing" >&2
	exit 1
fi
uid=$(id -u olympium)
runtime=/run/user/$uid
install -d -m 700 -o olympium -g olympium "$runtime"
sock=""
for cand in ${XDG_RUNTIME_DIR:+$XDG_RUNTIME_DIR/wayland-0} /run/dev-desktop/wayland-0; do
	if [ -S "$cand" ]; then
		sock=$cand
		break
	fi
done
if [ -n "$sock" ]; then
	chmod a+rx "$(dirname "$sock")" 2>/dev/null || true
	chmod a+rw "$sock" 2>/dev/null || true
	ln -sfn "$sock" "$runtime/wayland-0"
fi
# A software renderer. The live image's compositor is pixman, and QEMU's
# display has no GPU that Firefox can use.
# Ubuntu's kernel refuses the user namespace Firefox's sandbox wants unless
# apparmor_restrict_unprivileged_userns is 0. If the first start dies for
# that reason, start again with the content sandbox off so the window still opens.
launch() {
	# shellcheck disable=SC2086
	runuser -u olympium -- env \
		HOME=/home/olympium \
		USER=olympium \
		LOGNAME=olympium \
		XDG_RUNTIME_DIR="$runtime" \
		WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" \
		GDK_BACKEND=wayland \
		MOZ_ENABLE_WAYLAND=1 \
		MOZ_WEBRENDER=0 \
		MOZ_ACCELERATED=0 \
		LIBGL_ALWAYS_SOFTWARE=1 \
		GALLIUM_DRIVER=llvmpipe \
		MOZ_DBUS_REMOTE=1 \
		"$@" \
		/usr/bin/dbus-run-session -- "$REAL" $pages
}
pages=$(printf '%s ' "$@")
log=/tmp/firefox.log
: > "$log"
launch >>"$log" 2>&1
code=$?
if grep -E -q 'UserNamespace|EPERM' "$log"; then
	echo "firefox: user namespaces are blocked, so the content sandbox is off" > /dev/kmsg 2>/dev/null || true
	echo "firefox: user namespaces are blocked, so the content sandbox is off" >>"$log"
	launch MOZ_DISABLE_CONTENT_SANDBOX=1 >>"$log" 2>&1
	code=$?
fi
if [ "$code" -ne 0 ]; then
	echo "firefox: exit $code" > /dev/kmsg 2>/dev/null || true
fi
exit "$code"
