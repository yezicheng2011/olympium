<Window x:Class="Linkspan.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Linkspan"
        Icon="Assets/Linkspan.ico"
        Width="1080"
        Height="720"
        MinWidth="720"
        MinHeight="480"
        Background="{DynamicResource AppBackground}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource AppText}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppLine}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
          <TextBlock Text="Appearance" Foreground="{DynamicResource AppMuted}" Margin="4,0,0,4" />
          <ComboBox x:Name="AppearanceBox" SelectionChanged="AppearanceChanged">
            <ComboBoxItem Content="Follow system" Tag="system" />
            <ComboBoxItem Content="Light" Tag="light" />
            <ComboBoxItem Content="Dark" Tag="dark" />
          </ComboBox>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Linkspan" FontSize="22" FontWeight="SemiBold" Margin="4,4,4,12" />
          <Button x:Name="OverviewButton" Content="Overview" Click="ShowOverview" Margin="0,0,0,6" HorizontalContentAlignment="Left" />
          <Button x:Name="ProgramsButton" Content="Programs" Click="ShowPrograms" Margin="0,0,0,6" HorizontalContentAlignment="Left" />
          <Button x:Name="CompatibilityButton" Content="Compatibility" Click="ShowCompatibility" Margin="0,0,0,6" HorizontalContentAlignment="Left" />
          <Button x:Name="LimitsButton" Content="Limits" Click="ShowLimits" HorizontalContentAlignment="Left" />
        </StackPanel>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28">
      <StackPanel x:Name="Content" MaxWidth="820" HorizontalAlignment="Left" />
    </ScrollViewer>
  </Grid>
</Window>
