<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.olympium.validation.gms">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="37" />
    <queries>
        <package android:name="com.google.android.gms" />
        <package android:name="com.android.vending" />
    </queries>
    <application android:label="GMS compatibility probe" android:debuggable="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".Probe" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
